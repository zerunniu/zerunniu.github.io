---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
const entries = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Experience"
  description="Research, teaching, and education experience of Zerun Niu at the University of Sydney, UNSW Sydney, and DUAL Group."
>
  <section class="page-shell">
    <span class="eyebrow">Experience timeline</span>
    <div class="page-intro">
      <h1>
        Research practice, <span class="gradient-text">shared clearly.</span>
      </h1><p class="lede">
        Ongoing research and teaching across the University of Sydney, UNSW
        Sydney, and the DUAL Group.
      </p>
    </div>
    <div class="experience-map">
      {
        entries.map((entry, index) => (
          <article data-pagefind-body>
            <div class="timeline-axis">
              <>
                <span>0{index + 1}</span>
                <i />
              </>
            </div>
            <div class="experience-period">
              {entry.data.start}
              <br />— {entry.data.end}
            </div>
            <div class="experience-body">
              <span>
                {entry.data.kind} · {entry.data.location}
              </span>
              <h2>{entry.data.role}</h2>
              <h3>{entry.data.organisation}</h3>
              <p>{entry.data.summary}</p>
              <ul>
                {entry.data.evidence.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
<style>
  .page-intro {
    display: grid;
    grid-template-columns: 1.1fr 0.55fr;
    gap: 2rem;
    align-items: end;
  }
  .experience-map {
    margin-top: 4rem;
    border-top: 1px solid var(--line);
  }
  .experience-map article {
    display: grid;
    grid-template-columns: 4rem 8rem 1fr;
    gap: 1.4rem;
    min-height: 18rem;
    border-bottom: 1px solid var(--line);
  }
  .timeline-axis {
    position: relative;
    padding-top: 1.5rem;
    color: var(--cyan);
    font:
      0.65rem/1.4 "Geist Mono Variable",
      monospace;
  }
  .timeline-axis i {
    position: absolute;
    left: 0.52rem;
    top: 3.4rem;
    bottom: -1px;
    width: 1px;
    background: linear-gradient(var(--cyan), var(--line));
  }
  .experience-period {
    padding-top: 1.5rem;
    color: var(--muted);
    font:
      0.68rem/1.5 "Geist Mono Variable",
      monospace;
  }
  .experience-body {
    padding: 1.5rem 0 2.2rem;
  }
  .experience-body > span {
    color: var(--cyan);
    font:
      0.62rem/1.4 "Geist Mono Variable",
      monospace;
    text-transform: uppercase;
  }
  .experience-body h2 {
    margin: 1rem 0 0.3rem;
    font-size: clamp(1.6rem, 3.2vw, 3rem);
  }
  .experience-body h3 {
    color: var(--muted);
    font-size: 1rem;
    letter-spacing: 0;
  }
  .experience-body p {
    max-width: 68ch;
    color: var(--muted);
  }
  .experience-body ul {
    max-width: 74ch;
    padding-left: 1.1rem;
    color: var(--muted);
  }
  .experience-body li {
    margin-bottom: 0.45rem;
  }
  @media (max-width: 760px) {
    .page-intro {
      grid-template-columns: 1fr;
    }
    .experience-map article {
      grid-template-columns: 2rem 1fr;
    }
    .experience-period {
      grid-column: 2;
      padding: 1rem 0 0;
    }
    .experience-body {
      grid-column: 2;
      padding-top: 0;
    }
    .timeline-axis {
      grid-row: 1 / 3;
    }
  }
</style>
