---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ImmersiveLab from "../components/lab/ImmersiveLab";
import ProjectCard from "../components/ProjectCard.astro";
import PublicationRow from "../components/PublicationRow.astro";
import DigitalZerun from "../components/agent/DigitalZerun";

const [profileEntry] = await getCollection("profile");
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = projects.filter((project) => project.data.featured);
const publications = (await getCollection("publications"))
  .filter((paper) => paper.data.selected)
  .sort((a, b) => b.data.year - a.data.year);
const experiences = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);
const profile = profileEntry.data;
const labProjects = featured.map((project) => ({
  slug: project.id,
  ...project.data,
}));
const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  url: "https://zerunniu.github.io",
  image: "https://zerunniu.github.io/assets/zerun-niu.jpg",
  email: `mailto:${profile.email}`,
  jobTitle: "AI Researcher and ML Systems Engineer",
  affiliation: [
    { "@type": "CollegeOrUniversity", name: "The University of Sydney" },
    { "@type": "CollegeOrUniversity", name: "UNSW Sydney" },
  ],
  sameAs: profile.socials.map((social) => social.url),
  knowsAbout: profile.researchInterests,
};
---

<BaseLayout structuredData={personJsonLd}>
  <section class="home-hero section-shell">
    <div class="hero-copy">
      <div>
        <span class="eyebrow">Sydney · research signal 01</span>
        <h1>
          <span class="gradient-text">Reliable AI</span><br />under real
          constraints.
        </h1>
      </div>
      <div class="hero-intro">
        <p class="lede">{profile.summary}</p>
        <div class="identity-stack" aria-label="Current roles">
          <span><i class="status-dot"></i>MPhil in Computer Science · USyd</span
          >
          <span>Research Assistant · DUAL Group</span>
          <span>Casual Academic · USyd + UNSW</span>
        </div>
        <div class="button-row">
          <a class="button-primary" href="#research-lab"
            >Enter the lab <span aria-hidden="true">↓</span></a
          >
          <a class="button-secondary" href="/cv">Review my CV</a>
        </div>
      </div>
    </div>
    <div id="research-lab">
      <ImmersiveLab
        projects={labProjects}
        client:media="(min-width: 821px) and (prefers-reduced-motion: no-preference)"
      />
    </div>
  </section>

  <section class="section-shell signal-section">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Research operating system</span><h2>
          Method, evidence, deployment.
        </h2>
      </div>
      <p>
        I work across the full loop: identifying a reliability gap, designing an
        algorithm, building controlled experiments, and turning the result into
        a reproducible system.
      </p>
    </div>
    <div class="signal-grid">
      <article>
        <span>01 / Method</span><h3>
          Algorithms with explicit failure models
        </h3><p>
          From controlled evidence feedback to distributional robustness and
          federated equilibrium learning.
        </p>
      </article>
      <article>
        <span>02 / Evidence</span><h3>
          Calibration, ablations, reproducibility
        </h3><p>
          Experiments are designed to explain when a system is right, how
          confident it should be, and where it breaks.
        </p>
      </article>
      <article>
        <span>03 / System</span><h3>Research that survives deployment</h3><p>
          Reliable pipelines, constrained networks, maintainable interfaces, and
          artifacts built for repeatable use.
        </p>
      </article>
    </div>
  </section>

  <section class="section-shell" id="featured-research">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Selected research</span><h2>
          Four active workstations.
        </h2>
      </div>
      <p>
        The immersive layer is optional. These case files keep the role, method,
        evidence, and links immediately scannable on every device.
      </p>
    </div>
    <div class="project-grid">
      {
        featured.map((project) => (
          <ProjectCard slug={project.id} project={project.data} />
        ))
      }
    </div>
    <div class="section-end">
      <a class="button-secondary" href="/projects">View all projects →</a>
    </div>
  </section>

  <section class="section-shell publication-section">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Research output</span><h2>
          Current publications.
        </h2>
      </div>
      <p>
        Statuses are stated exactly: published, submitted, or under review.
        First-author BRAVE work remains explicitly marked as under review at
        TMLR.
      </p>
    </div>
    <div>
      {
        publications.map((paper) => (
          <PublicationRow publication={paper.data} slug={paper.id} />
        ))
      }
    </div>
    <div class="section-end">
      <a class="button-secondary" href="/publications">Publication record →</a>
    </div>
  </section>

  <section class="section-shell experience-preview">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Current coordinates</span><h2>
          Research and teaching.
        </h2>
      </div>
      <p>
        My research practice is strengthened by teaching: precise explanations,
        careful feedback, and systems that help people reason through
        complexity.
      </p>
    </div>
    <div class="timeline-preview">
      {
        experiences.slice(0, 4).map((entry) => (
          <article>
            <span>
              {entry.data.start} — {entry.data.end}
            </span>
            <h3>{entry.data.role}</h3>
            <p>{entry.data.organisation}</p>
          </article>
        ))
      }
    </div>
    <div class="section-end">
      <a class="button-secondary" href="/experience">Full timeline →</a>
    </div>
  </section>

  <section class="section-shell" id="digital-zerun">
    <DigitalZerun
      workerUrl={
        import.meta.env.PUBLIC_VOICE_WORKER_URL ||
        "https://zerun-digital-agent.zniu9834.workers.dev"
      }
      turnstileSiteKey={
        import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "0x4AAAAAAEjYuq_yJE2BdwkX"
      }
      client:visible
    />
  </section>
</BaseLayout>

<style>
  .home-hero {
    padding-top: clamp(3.5rem, 7vw, 6.5rem);
  }
  .hero-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(20rem, 0.6fr);
    gap: 2.5rem;
    align-items: end;
  }
  .hero-copy h1 {
    margin-bottom: 0;
  }
  .hero-intro {
    padding-bottom: 0.4rem;
  }
  .identity-stack {
    display: grid;
    gap: 0.5rem;
    margin: 1.5rem 0;
    color: var(--muted);
    font:
      0.72rem/1.5 "Geist Mono Variable",
      monospace;
  }
  .identity-stack span:first-child {
    color: var(--text);
  }
  .identity-stack i {
    margin-right: 0.55rem;
  }
  .signal-section {
    border-top: 1px solid var(--line);
  }
  .signal-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
  }
  .signal-grid article {
    min-height: 20rem;
    padding: 1.5rem;
    border-right: 1px solid var(--line);
    background: var(--panel);
  }
  .signal-grid article:last-child {
    border-right: 0;
  }
  .signal-grid span {
    color: var(--cyan);
    font:
      0.65rem/1.4 "Geist Mono Variable",
      monospace;
  }
  .signal-grid h3 {
    margin: 7rem 0 1rem;
    max-width: 16ch;
  }
  .signal-grid p {
    color: var(--muted);
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .section-end {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.25rem;
  }
  .publication-section {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .timeline-preview {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
  }
  .timeline-preview article {
    padding: 1.25rem 1rem 1.25rem 0;
  }
  .timeline-preview span {
    color: var(--cyan);
    font:
      0.63rem/1.4 "Geist Mono Variable",
      monospace;
  }
  .timeline-preview h3 {
    margin: 1.8rem 0 0.6rem;
    font-size: 1.08rem;
  }
  .timeline-preview p {
    color: var(--muted);
    font-size: 0.82rem;
  }
  @media (max-width: 900px) {
    .hero-copy {
      grid-template-columns: 1fr;
    }
    .signal-grid {
      grid-template-columns: 1fr;
    }
    .signal-grid article {
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .signal-grid h3 {
      margin-top: 3rem;
    }
    .project-grid {
      grid-template-columns: 1fr;
    }
    .timeline-preview {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .timeline-preview {
      grid-template-columns: 1fr;
    }
  }
</style>
