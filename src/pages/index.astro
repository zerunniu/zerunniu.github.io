---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SkillsOrb from "../components/SkillsOrb.astro";
import DigitalZerun from "../components/agent/DigitalZerun";

const [profileEntry] = await getCollection("profile");
const profile = profileEntry.data;

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = projects.filter((project) => project.data.featured);

const publications = (await getCollection("publications"))
  .filter((paper) => paper.data.selected)
  .sort((a, b) => b.data.year - a.data.year);

const experiences = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);

const statusLabel: Record<string, string> = {
  published: "Published",
  "under-review": "Under review",
  submitted: "Submitted",
  active: "Active",
  completed: "Completed",
};
const statusClass: Record<string, string> = {
  published: "is-live",
  "under-review": "is-review",
  active: "is-live",
};
const evidenceId: Record<string, string> = {
  brave: "brave-metrics",
  wasecom: "wasecom-robustness",
  fedeq: "fedeq-system",
  "dual-group-website": "dual-deployment",
};

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  url: "https://zerunniu.github.io",
  image: "https://zerunniu.github.io/assets/zerun-niu.jpg",
  email: `mailto:${profile.email}`,
  jobTitle: "AI Research Engineer",
  affiliation: [
    { "@type": "CollegeOrUniversity", name: "The University of Sydney" },
    { "@type": "CollegeOrUniversity", name: "UNSW Sydney" },
  ],
  sameAs: profile.socials.map((social) => social.url),
  knowsAbout: profile.researchInterests,
};
---

<BaseLayout structuredData={personJsonLd}>
  <section class="section-shell hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="hero-id">
          <img
            class="portrait"
            src="/assets/zerun-niu.jpg"
            width="480"
            height="600"
            alt="Zerun Niu"
          />
          <div class="who">
            Sydney, Australia<br />
            <span>MPhil, The University of Sydney · DUAL Group</span>
          </div>
        </div>
        <span class="eyebrow">Sydney · reliable &amp; efficient AI</span>
        <h1>Zerun Niu</h1>
        <p class="hero-role">
          AI Research Engineer · Agentic AI &amp; Reliable ML
          <span>MPhil in Computer Science · The University of Sydney · DUAL Group</span>
        </p>
        <p class="hero-intro">{profile.summary}</p>
        <div class="chips">
          <span class="chip">MPhil · USyd</span>
          <span class="chip">Research Assistant · DUAL Group</span>
          <span class="chip">Casual Academic · USyd + UNSW</span>
        </div>
        <div class="button-row">
          <button
            class="button-primary"
            type="button"
            data-magnetic
            onclick="document.getElementById('digital-zerun')?.scrollIntoView()"
          >
            ▶ Talk to Digital Zerun
          </button>
          <a
            class="button-secondary"
            data-magnetic
            href="/assets/Zerun_Niu_Research_Engineer_Resume.pdf">Download CV</a
          >
        </div>
      </div>
      <div class="hero-visual">
        <SkillsOrb />
      </div>
    </div>
  </section>

  <div class="rule"></div>

  <section class="section-shell" id="research">
    <div class="section-heading reveal">
      <div>
        <span class="eyebrow">Selected research</span>
        <h2>Systems built to answer hard questions.</h2>
      </div>
      <p>
        Each case states the problem, my role, the evidence, and the public
        artifact. Statuses are exact: published, submitted, or under review.
      </p>
    </div>
    <div class="cards">
      {
        featured.map((project, index) => (
          <article
            class="card reveal"
            id={`p-${project.id}`}
            style={`--i: ${index}`}
          >
            <div class="card-top">
              <span class={`tag ${statusClass[project.data.status] ?? ""}`}>
                {statusLabel[project.data.status] ?? project.data.status}
              </span>
              <span class="card-key">
                {project.data.shortTitle} · {project.data.period}
              </span>
            </div>
            <h3>{project.data.title}</h3>
            <p>{project.data.summary}</p>
            <p class="role" id={project.id === "brave" ? "brave-mechanism" : undefined}>
              {project.data.role}
            </p>
            <div class="card-foot" id={evidenceId[project.id]}>
              {project.data.metrics[0] && (
                <span class="metric">
                  {project.data.metrics[0].value} {project.data.metrics[0].label}
                </span>
              )}
              {project.data.links.map((link) => (
                <a href={link.url} rel="noopener" target="_blank">
                  {link.label} ↗
                </a>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <div class="rule"></div>

  <section class="section-shell" id="publications">
    <div class="section-heading reveal">
      <div>
        <span class="eyebrow">Publications</span>
        <h2>Evidence, status, provenance.</h2>
      </div>
      <p>
        Every listing uses a precise status. BRAVE is first-author work under
        review at TMLR; WaSeCom is published in IEEE JSAC.
      </p>
    </div>
    <div class="pubs">
      {
        publications.map((paper, index) => (
          <div class="pub reveal" style={`--i: ${index}`}>
            <span class="yr">{paper.data.year}</span>
            <div>
              <h3>{paper.data.title}</h3>
              <p class="authors">
                {paper.data.authors.map((name, i) => (
                  <>
                    {i > 0 && ", "}
                    {name === "Zerun Niu" ? <strong>{name}</strong> : name}
                  </>
                ))}
                {" · "}
                <span class="venue">{paper.data.venue}</span>
              </p>
            </div>
            <div class="side">
              <span class={paper.data.status === "under-review" ? "is-review" : ""}>
                {statusLabel[paper.data.status] ?? paper.data.status}
              </span>
              {paper.data.openreview && (
                <a href={paper.data.openreview} rel="noopener" target="_blank">
                  OpenReview ↗
                </a>
              )}
              {paper.data.doi && (
                <a
                  href={`https://doi.org/${paper.data.doi}`}
                  rel="noopener"
                  target="_blank"
                >
                  DOI ↗
                </a>
              )}
              {paper.data.arxiv && (
                <a
                  href={`https://arxiv.org/abs/${paper.data.arxiv}`}
                  rel="noopener"
                  target="_blank"
                >
                  arXiv ↗
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <div class="rule"></div>

  <section class="section-shell" id="experience">
    <div class="section-heading reveal">
      <div>
        <span class="eyebrow">Experience</span>
        <h2>Research practice, strengthened by teaching.</h2>
      </div>
      <p>
        Ongoing research and teaching across the University of Sydney, UNSW
        Sydney, and the DUAL Group.
      </p>
    </div>
    <div class="timeline">
      {
        experiences.map((entry, index) => (
          <div class="tl-row reveal" style={`--i: ${index}`}>
            <span class="tl-when">
              {entry.data.start} — {entry.data.end}
            </span>
            <div class="tl-what">
              <h3>{entry.data.role}</h3>
              <p>
                <span class="tl-kind">{entry.data.kind}</span> ·{" "}
                {entry.data.organisation} · {entry.data.summary}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <div class="rule"></div>

  <section class="section-shell" id="digital-zerun">
    <span class="eyebrow reveal">Digital Zerun</span>
    <div class="reveal">
      <DigitalZerun
        workerUrl={
          import.meta.env.PUBLIC_VOICE_WORKER_URL ||
          "https://zerun-digital-agent.zniu9834.workers.dev"
        }
        turnstileSiteKey={
          import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ||
          "0x4AAAAAAEjYuq_yJE2BdwkX"
        }
        client:visible
      />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: clamp(2rem, 5vw, 4rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .hero-id {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.1rem;
  }
  .portrait {
    flex: none;
    width: clamp(76px, 9vw, 104px);
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 12%;
    border-radius: 14px;
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-sm);
  }
  .who {
    font: 400 0.72rem/1.55 var(--font-mono);
    color: var(--muted);
  }
  .who span {
    color: var(--faint);
  }
  h1 {
    font-size: clamp(3.2rem, 10vw, 6.4rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
    margin: 0.6rem 0 0;
    background: linear-gradient(
      95deg,
      var(--text) 0%,
      var(--text) 55%,
      var(--cyan-soft) 92%
    );
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }
  .hero-role {
    font: 400 0.92rem/1.5 var(--font-mono);
    color: var(--text);
    margin: 1.2rem 0 0;
  }
  .hero-role span {
    display: block;
    color: var(--muted);
    font-size: 0.78rem;
    margin-top: 0.35rem;
  }
  .hero-intro {
    max-width: 48ch;
    margin: 1.4rem 0 0;
    padding-left: 1rem;
    border-left: 2px solid var(--line-strong);
    font: 400 0.86rem/1.7 var(--font-mono);
    color: var(--muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .button-row {
    margin-top: 1.8rem;
  }

  @media (max-width: 880px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---- research cards ---- */
  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.4rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--panel-solid);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 14px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
    background: radial-gradient(
      240px circle at var(--mx, 50%) var(--my, 0%),
      color-mix(in srgb, var(--cyan) 12%, transparent),
      transparent 70%
    );
  }
  .card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
  }
  .card:hover::after {
    opacity: 1;
  }
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .tag {
    font: 400 0.62rem/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.28rem 0.5rem;
    border-radius: 6px;
    border: 1px solid var(--line-strong);
    color: var(--muted);
    white-space: nowrap;
  }
  .tag.is-review {
    color: var(--orange);
    border-color: color-mix(in srgb, var(--orange) 45%, var(--line-strong));
    background: color-mix(in srgb, var(--orange) 8%, transparent);
  }
  .tag.is-live {
    color: var(--cyan-soft);
    border-color: color-mix(in srgb, var(--cyan) 40%, var(--line-strong));
  }
  .card-key {
    font: 400 0.72rem/1 var(--font-mono);
    color: var(--faint);
  }
  .card h3 {
    font-size: 1.12rem;
    line-height: 1.25;
  }
  .card p {
    margin: 0;
    font-size: 0.86rem;
    color: var(--muted);
  }
  .card .role {
    font: 400 0.7rem/1.6 var(--font-mono);
    color: var(--text);
  }
  .card-foot {
    margin-top: auto;
    padding-top: 0.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    align-items: center;
    border-top: 1px solid var(--line);
    font: 400 0.7rem/1 var(--font-mono);
  }
  .card-foot .metric {
    color: var(--faint);
    margin-right: auto;
  }
  .card-foot a {
    color: var(--cyan-soft);
  }
  .card-foot a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 720px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }

  /* ---- publications ---- */
  .pubs {
    border-top: 1px solid var(--line);
  }
  .pub {
    display: grid;
    grid-template-columns: 4rem 1fr auto;
    gap: 1.2rem;
    align-items: start;
    padding: 1.3rem 0.4rem;
    border-bottom: 1px solid var(--line);
    transition:
      background 0.18s ease,
      padding-left 0.18s ease;
  }
  .pub:hover {
    background: var(--panel);
    padding-left: 0.9rem;
  }
  .pub .yr {
    font: 400 0.82rem/1.6 var(--font-mono);
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
  .pub h3 {
    font-size: 1.02rem;
    line-height: 1.3;
  }
  .pub .authors {
    margin: 0.4rem 0 0;
    font: 400 0.7rem/1.5 var(--font-mono);
    color: var(--muted);
  }
  .pub .venue {
    color: var(--text);
  }
  .pub .side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    font: 400 0.68rem/1 var(--font-mono);
  }
  .pub .side .is-review {
    color: var(--orange);
  }
  .pub .side a {
    color: var(--cyan-soft);
  }
  .pub .side a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 720px) {
    .pub {
      grid-template-columns: 3rem 1fr;
    }
    .pub .side {
      grid-column: 2;
      align-items: flex-start;
      flex-flow: row wrap;
      gap: 0.8rem;
    }
  }

  /* ---- experience ---- */
  .tl-row {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1.4rem;
    padding: 1.15rem 0;
    border-top: 1px solid var(--line);
  }
  .tl-row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .tl-when {
    font: 400 0.72rem/1.6 var(--font-mono);
    color: var(--faint);
  }
  .tl-what h3 {
    font-size: 1rem;
  }
  .tl-what p {
    margin: 0.25rem 0 0;
    font: 400 0.72rem/1.6 var(--font-mono);
    color: var(--muted);
  }
  .tl-kind {
    color: var(--cyan-soft);
    text-transform: capitalize;
  }
  @media (max-width: 620px) {
    .tl-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }

  #digital-zerun .eyebrow {
    display: inline-flex;
    margin-bottom: 1.5rem;
  }
</style>
