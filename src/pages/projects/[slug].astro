---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BraveMechanism from "../../components/BraveMechanism";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const isBrave = project.id === "brave";
const schema = isBrave
  ? {
      "@context": "https://schema.org",
      "@type": "ScholarlyArticle",
      headline: project.data.title,
      author: { "@type": "Person", name: "Zerun Niu" },
      about: project.data.tags,
      description: project.data.summary,
      url: `https://zerunniu.github.io/projects/${project.id}`,
    }
  : {
      "@context": "https://schema.org",
      "@type": "SoftwareSourceCode",
      name: project.data.title,
      author: { "@type": "Person", name: "Zerun Niu" },
      description: project.data.summary,
      codeRepository: project.data.links.find(
        (link: { label: string }) => link.label === "Code",
      )?.url,
    };
---

<BaseLayout
  title={project.data.shortTitle}
  description={project.data.summary}
  structuredData={schema}
>
  <article
    class:list={[
      "page-shell",
      "project-detail",
      `accent-${project.data.accent}`,
    ]}
    data-pagefind-body
  >
    <a class="back-link" href="/projects">← Research archive</a>
    <header class="project-header">
      <div>
        <div class="project-state">
          <span>{project.data.status.replace("-", " ")}</span><span
            >{project.data.period}</span
          >
        </div>
        <h1>{project.data.title}</h1>
        <p class="lede">{project.data.summary}</p>
      </div>
      <aside>
        <img src="/assets/zerun-niu.jpg" alt="Zerun Niu" />
        <span>My role</span>
        <p>{project.data.role}</p>
        <div class="project-links">
          {
            project.data.links.map((link) => (
              <a href={link.url}>{link.label} ↗</a>
            ))
          }
        </div>
      </aside>
    </header>
    {
      project.data.metrics.length > 0 && (
        <section
          class="metric-rack"
          id={isBrave ? "brave-metrics" : undefined}
          aria-label="Public metrics"
        >
          {project.data.metrics.map((metric) => (
            <div>
              <strong>{metric.value}</strong>
              <span>{metric.label}</span>
            </div>
          ))}
        </section>
      )
    }
    {isBrave && <BraveMechanism client:load />}
    <div class="project-body">
      <div class="prose"><Content /></div>
      <aside class="technical-index">
        <span>Research index</span><dl>
          <dt>Status</dt><dd>{project.data.status.replace("-", " ")}</dd><dt>
            Role
          </dt><dd>{project.data.role}</dd><dt>Methods</dt><dd>
            {project.data.tags.join(" · ")}
          </dd>
        </dl>
      </aside>
    </div>
  </article>
</BaseLayout>
<style is:global>
  .project-detail {
    --accent: var(--cyan);
  }
  .project-detail.accent-indigo {
    --accent: var(--indigo);
  }
  .project-detail.accent-orange {
    --accent: var(--orange);
  }
  .project-detail.accent-violet {
    --accent: var(--violet);
  }
  .back-link {
    color: var(--muted);
    font:
      0.68rem/1.4 "Geist Mono Variable",
      monospace;
  }
  .project-header {
    display: grid;
    grid-template-columns: 1fr minmax(16rem, 0.34fr);
    gap: 3rem;
    margin-top: 2rem;
    align-items: end;
  }
  .project-header h1 {
    max-width: 15ch;
    font-size: clamp(2.65rem, 7vw, 6.3rem);
  }
  .project-state {
    display: flex;
    gap: 1rem;
    color: var(--accent);
    font:
      0.68rem/1.4 "Geist Mono Variable",
      monospace;
    text-transform: uppercase;
  }
  .project-header aside {
    padding: 1.2rem;
    border: 1px solid color-mix(in srgb, var(--accent) 32%, var(--line));
    border-radius: 14px;
    background: var(--panel);
  }
  .project-header aside img {
    width: 4.5rem;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    filter: grayscale(0.2);
  }
  .project-header aside > span {
    display: block;
    margin-top: 1rem;
    color: var(--accent);
    font:
      0.62rem/1.4 "Geist Mono Variable",
      monospace;
    text-transform: uppercase;
  }
  .project-header aside p {
    color: var(--muted);
    font-size: 0.82rem;
  }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  .project-links a {
    color: var(--accent);
    font:
      0.67rem/1.4 "Geist Mono Variable",
      monospace;
  }
  .metric-rack {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 4rem 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
  }
  .metric-rack div {
    padding: 1.35rem;
    border-right: 1px solid var(--line);
  }
  .metric-rack div:last-child {
    border-right: 0;
  }
  .metric-rack strong {
    display: block;
    color: var(--accent);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
  }
  .metric-rack span {
    color: var(--muted);
    font:
      0.65rem/1.4 "Geist Mono Variable",
      monospace;
  }
  .project-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.32fr);
    gap: 4rem;
    margin-top: 4rem;
  }
  .technical-index {
    position: sticky;
    top: 6rem;
    height: fit-content;
    border-top: 1px solid var(--accent);
    padding-top: 1rem;
  }
  .technical-index > span {
    color: var(--accent);
    font:
      0.64rem/1.4 "Geist Mono Variable",
      monospace;
    text-transform: uppercase;
  }
  .technical-index dt {
    margin-top: 1rem;
    color: var(--muted);
    font:
      0.6rem/1.4 "Geist Mono Variable",
      monospace;
    text-transform: uppercase;
  }
  .technical-index dd {
    margin: 0.25rem 0 0;
    color: var(--text);
    font-size: 0.78rem;
  }
  .brave-mechanism {
    margin: 4rem 0;
    padding: clamp(1.2rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--panel);
    overflow: hidden;
  }
  .brave-mechanism header {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: end;
  }
  .brave-mechanism header span {
    color: var(--orange);
    font:
      0.62rem/1.4 "Geist Mono Variable",
      monospace;
    text-transform: uppercase;
  }
  .brave-mechanism h2 {
    max-width: 15ch;
    margin: 0.7rem 0 0;
    font-size: clamp(1.8rem, 3vw, 3rem);
  }
  .mechanism-switch {
    display: inline-flex;
    padding: 0.2rem;
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .mechanism-switch button {
    border: 0;
    border-radius: 6px;
    padding: 0.5rem 0.7rem;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .mechanism-switch button.is-active {
    background: color-mix(in srgb, var(--orange) 12%, transparent);
    color: var(--orange);
  }
  .mechanism-grid {
    display: grid;
    grid-template-columns: 0.45fr auto 1fr auto 0.85fr;
    gap: 1rem;
    align-items: center;
    margin-top: 2.5rem;
  }
  .worker-column,
  .posterior-column,
  .global-column {
    padding: 1rem;
    border: 1px solid var(--line);
    background: var(--bg-soft);
  }
  .worker-column > span,
  .posterior-column > span,
  .global-column > span {
    display: block;
    margin-bottom: 0.8rem;
    color: var(--muted);
    font:
      0.57rem/1.4 "Geist Mono Variable",
      monospace;
    text-transform: uppercase;
  }
  .worker-column {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .worker-column > span {
    width: 100%;
  }
  .worker-column i {
    display: grid;
    place-items: center;
    width: 2rem;
    aspect-ratio: 1;
    border: 1px solid var(--orange);
    border-radius: 50%;
    color: var(--orange);
    font-style: normal;
    font:
      0.65rem/1 "Geist Mono Variable",
      monospace;
  }
  .worker-column i.missing {
    border-style: dashed;
    border-color: var(--line-strong);
    color: var(--muted);
  }
  .posterior-column {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.4rem;
  }
  .posterior-column > span {
    grid-column: 1 / -1;
  }
  .posterior-column div {
    padding: 0.65rem;
    border: 1px solid var(--line);
  }
  .posterior-column small,
  .posterior-column b {
    display: block;
  }
  .posterior-column small {
    color: var(--muted);
    font:
      0.55rem/1.4 "Geist Mono Variable",
      monospace;
  }
  .posterior-column b {
    margin: 0.4rem 0;
    color: var(--orange);
  }
  .posterior-column em {
    display: block;
    width: var(--level);
    height: 2px;
    background: var(--orange);
    transition: width 300ms ease;
  }
  .global-column strong {
    color: var(--orange);
    font-size: 2.6rem;
  }
  .global-column p {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.74rem;
  }
  .flow-arrow {
    color: var(--orange);
  }
  .feedback-path {
    margin-top: 1rem;
    border-top: 1px dashed color-mix(in srgb, var(--orange) 50%, transparent);
    padding-top: 0.6rem;
    color: var(--orange);
    text-align: center;
    font:
      0.62rem/1.4 "Geist Mono Variable",
      monospace;
  }
  .uncontrolled .global-column {
    border-color: var(--danger);
  }
  .uncontrolled .global-column strong,
  .uncontrolled .feedback-path {
    color: var(--danger);
  }
  @media (max-width: 850px) {
    .project-header,
    .project-body {
      grid-template-columns: 1fr;
    }
    .metric-rack {
      grid-template-columns: repeat(2, 1fr);
    }
    .mechanism-grid {
      grid-template-columns: 1fr;
    }
    .flow-arrow {
      transform: rotate(90deg);
      text-align: center;
    }
    .technical-index {
      position: static;
    }
  }
  @media (max-width: 520px) {
    .metric-rack {
      grid-template-columns: 1fr;
    }
    .brave-mechanism header {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
