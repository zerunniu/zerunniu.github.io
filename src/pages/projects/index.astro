---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const requestedTag = Astro.url.searchParams.get("tag");
const visible = requestedTag
  ? projects.filter((project) =>
      project.data.tags.some(
        (tag) => tag.toLowerCase() === requestedTag.toLowerCase(),
      ),
    )
  : projects;
const tags = [
  ...new Set(projects.flatMap((project) => project.data.tags)),
].sort();
---

<BaseLayout
  title="Research projects"
  description="Research and engineering projects by Zerun Niu across reliable ML, federated learning, semantic communication, and research tooling."
>
  <section class="page-shell">
    <span class="eyebrow">Research archive</span>
    <div class="projects-head">
      <h1>
        Systems built to answer <span class="gradient-text"
          >hard questions.</span
        >
      </h1><p class="lede">
        Each case file states the problem, my role, the evidence, and the public
        artifacts. No subjective skill bars; no inflated project status.
      </p>
    </div>
    <nav class="tag-filter" aria-label="Filter projects">
      <a class={!requestedTag ? "is-active" : ""} href="/projects">All</a>
      {
        tags.map((tag) => (
          <a
            class={requestedTag === tag ? "is-active" : ""}
            href={`/projects?tag=${encodeURIComponent(tag)}`}
          >
            {tag}
          </a>
        ))
      }
    </nav>
    <p class="filter-status">
      Showing {visible.length} of {projects.length} projects{
        requestedTag && (
          <>
            {" "}
            for <strong>{requestedTag}</strong>
          </>
        )
      }
    </p>
    <div class="project-grid">
      {
        visible.map((project) => (
          <ProjectCard slug={project.id} project={project.data} />
        ))
      }
    </div>
  </section>
</BaseLayout>
<style>
  .projects-head {
    display: grid;
    grid-template-columns: 1.15fr 0.55fr;
    gap: 2rem;
    align-items: end;
  }
  .projects-head h1 {
    max-width: 13ch;
  }
  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    margin: 2rem 0 0;
    padding: 1rem 0;
    border-block: 1px solid var(--line);
  }
  .tag-filter a {
    color: var(--muted);
    font:
      0.68rem/1.6 "Geist Mono Variable",
      monospace;
  }
  .tag-filter a:hover,
  .tag-filter .is-active {
    color: var(--cyan);
  }
  .filter-status {
    color: var(--muted);
    font-size: 0.76rem;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  @media (max-width: 800px) {
    .projects-head,
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
