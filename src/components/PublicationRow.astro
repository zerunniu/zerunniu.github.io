---
interface Props {
  publication: {
    title: string;
    year: number;
    venue: string;
    status: string;
    authors: string[];
    doi?: string;
    arxiv?: string;
    openreview?: string;
  };
  slug?: string;
}
const { publication } = Astro.props;
const links = [
  publication.doi && {
    label: "DOI",
    href: `https://doi.org/${publication.doi}`,
  },
  publication.arxiv && {
    label: "arXiv",
    href: `https://arxiv.org/abs/${publication.arxiv}`,
  },
  publication.openreview && {
    label: "OpenReview",
    href: publication.openreview,
  },
].filter(Boolean) as { label: string; href: string }[];
---

<article class="publication-row" data-pagefind-body>
  <div class="pub-year">{publication.year}</div>
  <div>
    <div class="pub-status">
      {publication.status.replace("-", " ")} · {publication.venue}
    </div>
    <h3>{publication.title}</h3>
    <p>{publication.authors.join(", ")}</p>
  </div>
  <div class="pub-links">
    {links.map((link) => <a href={link.href}>{link.label} ↗</a>)}
  </div>
</article>

<style>
  .publication-row {
    display: grid;
    grid-template-columns: 5rem 1fr auto;
    gap: 1.4rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
  }
  .pub-year {
    color: var(--cyan);
    font:
      600 0.76rem/1.4 "Geist Mono Variable",
      monospace;
  }
  .pub-status {
    color: var(--muted);
    font:
      0.64rem/1.4 "Geist Mono Variable",
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  h3 {
    margin: 0.55rem 0;
    font-size: clamp(1.1rem, 2vw, 1.55rem);
    letter-spacing: -0.025em;
  }
  p {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .pub-links {
    display: flex;
    gap: 0.8rem;
    align-items: start;
  }
  .pub-links a {
    color: var(--cyan);
    font:
      0.68rem/1.4 "Geist Mono Variable",
      monospace;
  }
  @media (max-width: 700px) {
    .publication-row {
      grid-template-columns: 3rem 1fr;
    }
    .pub-links {
      grid-column: 2;
    }
  }
</style>
