---
interface ProjectData {
  title: string;
  shortTitle: string;
  summary: string;
  role: string;
  status: string;
  period: string;
  tags: string[];
  accent: "cyan" | "indigo" | "orange" | "violet";
  metrics: { value: string; label: string }[];
}

interface Props {
  slug: string;
  project: ProjectData;
  compact?: boolean;
}

const { slug, project, compact = false } = Astro.props;
---

<article
  class:list={["project-card", `accent-${project.accent}`, { compact }]}
  data-pagefind-body
>
  <div class="project-card-meta">
    <span>{project.status.replace("-", " ")}</span>
    <span>{project.period}</span>
  </div>
  <h3><a href={`/projects/${slug}`}>{project.title}</a></h3>
  <p>{project.summary}</p>
  {!compact && <strong class="project-role">{project.role}</strong>}
  {
    project.metrics.length > 0 && (
      <div class="project-metrics">
        {project.metrics.slice(0, compact ? 1 : 3).map((metric) => (
          <span>
            <b>{metric.value}</b>
            {metric.label}
          </span>
        ))}
      </div>
    )
  }
  <footer>
    <span>{project.tags.slice(0, 3).join(" · ")}</span>
    <a href={`/projects/${slug}`} aria-label={`Open ${project.shortTitle}`}
      >Inspect →</a
    >
  </footer>
</article>

<style>
  .project-card {
    --accent: var(--cyan);
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 27rem;
    padding: 1.45rem;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: linear-gradient(
      150deg,
      color-mix(in srgb, var(--panel-solid) 84%, transparent),
      color-mix(in srgb, var(--accent) 4%, var(--bg))
    );
    overflow: hidden;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }
  .project-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 1.4rem;
    width: 5rem;
    height: 2px;
    background: var(--accent);
    box-shadow: 0 0 14px var(--accent);
  }
  .project-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.16);
  }
  .accent-indigo {
    --accent: var(--indigo);
  }
  .accent-orange {
    --accent: var(--orange);
  }
  .accent-violet {
    --accent: var(--violet);
  }
  .project-card-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--accent);
    font:
      0.64rem/1.4 "Geist Mono Variable",
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  h3 {
    margin: 2.8rem 0 1rem;
    font-size: clamp(1.35rem, 2vw, 2rem);
  }
  h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  p {
    color: var(--muted);
  }
  .project-role {
    display: block;
    margin-top: auto;
    padding-top: 1.5rem;
    font-size: 0.78rem;
    font-weight: 540;
    color: color-mix(in srgb, var(--text) 82%, var(--muted));
  }
  .project-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.55rem;
    margin-top: 1rem;
  }
  .project-metrics span {
    color: var(--muted);
    font:
      0.58rem/1.35 "Geist Mono Variable",
      monospace;
  }
  .project-metrics b {
    display: block;
    color: var(--accent);
    font-size: 0.92rem;
  }
  footer {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    margin-top: 1.3rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font:
      0.62rem/1.4 "Geist Mono Variable",
      monospace;
  }
  footer a {
    position: relative;
    z-index: 1;
    color: var(--accent);
    white-space: nowrap;
  }
  .compact {
    min-height: 20rem;
  }
  .compact h3 {
    margin-top: 2rem;
  }
  @media (max-width: 560px) {
    .project-metrics {
      grid-template-columns: 1fr;
    }
  }
</style>
