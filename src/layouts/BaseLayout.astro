---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "Zerun Niu — AI Research Engineer",
  description =
    "Zerun Niu — AI Research Engineer working on agentic AI and reliable ML: federated learning, semantic communication, calibration, and reproducible systems.",
  image = "/assets/og-zerun-lab.png",
  structuredData,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title.startsWith("Zerun") ? title : `${title} — Zerun Niu`;
const nav = [
  ["Research", "/#research"],
  ["Publications", "/#publications"],
  ["Experience", "/#experience"],
  ["Digital Zerun", "/#digital-zerun"],
  ["Contact", "/#contact"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f3f4f6" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/assets/zerun-niu-180.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <title>{pageTitle}</title>
    {
      structuredData && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }
    <script is:inline>
      try {
        const saved = localStorage.getItem("zerun-theme");
        if (saved === "light" || saved === "dark")
          document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-grid" aria-hidden="true"></div>
    <div class="cursor-dot" aria-hidden="true"></div>
    <div class="cursor-ring" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Zerun Niu home">
        <span class="brand-mark" aria-hidden="true">ZN</span>
        <span>
          <strong>Zerun Niu</strong>
          <small>AI Research Engineer</small>
        </span>
      </a>
      <nav id="primary-nav" aria-label="Primary navigation">
        {
          nav.map(([label, href]) => (
            <a href={href}>{label}</a>
          ))
        }
      </nav>
      <div class="header-actions">
        <button
          class="pill"
          type="button"
          data-magnetic
          onclick="document.getElementById('digital-zerun')?.scrollIntoView()"
        >
          <i aria-hidden="true"></i> Talk to Digital Zerun
        </button>
        <button
          class="nav-toggle"
          type="button"
          data-nav-toggle
          aria-controls="primary-nav"
          aria-expanded="false"
          aria-label="Open menu"
        >
          <span aria-hidden="true">≡</span>
        </button>
        <button
          class="icon-button"
          type="button"
          data-theme-toggle
          aria-label="Switch colour theme"
        >
          <span aria-hidden="true">◐</span>
        </button>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer" id="contact">
      <div>
        <span class="eyebrow">Contact</span>
        <h2>Signal remains open.</h2>
      </div>
      <a class="footer-mail" href="mailto:zerun.niu@sydney.edu.au"
        >zerun.niu@sydney.edu.au</a
      >
      <div class="footer-links">
        <a href="https://github.com/zerunniu">GitHub</a>
        <a href="https://www.linkedin.com/in/zerun-niu-265015300">LinkedIn</a>
        <a href="https://scholar.google.com/citations?user=2dTScwcAAAAJ"
          >Google Scholar</a
        >
        <a href="/assets/Zerun_Niu_Research_Engineer_Resume.pdf"
          >Industry résumé · PDF</a
        >
        <a href="/assets/Zerun_Niu_Academic_CV.pdf">Academic CV · PDF</a>
        <a href="/privacy">Privacy</a>
      </div>
      <small
        >© {new Date().getFullYear()} Zerun Niu. Built in Sydney. No tracking, no
        behavioural analytics.</small
      >
    </footer>
    <script>
      import "../scripts/interactions.ts";
    </script>
    <script is:inline>
      (() => {
        const toggle = document.querySelector("[data-nav-toggle]");
        const menu = document.getElementById("primary-nav");
        if (!(toggle instanceof HTMLButtonElement) || !menu) return;
        const set = (open) => {
          menu.toggleAttribute("data-open", open);
          toggle.setAttribute("aria-expanded", String(open));
          toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        };
        toggle.addEventListener("click", () =>
          set(!menu.hasAttribute("data-open")),
        );
        menu.addEventListener("click", (e) => {
          if (e.target instanceof HTMLAnchorElement) set(false);
        });
        document.addEventListener("click", (e) => {
          if (
            menu.hasAttribute("data-open") &&
            !menu.contains(e.target) &&
            !toggle.contains(e.target)
          )
            set(false);
        });
        window.addEventListener("keydown", (e) => {
          if (e.key === "Escape") set(false);
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const button = document.querySelector("[data-theme-toggle]");
        if (!(button instanceof HTMLButtonElement)) return;
        const root = document.documentElement;
        const isDark = () =>
          root.dataset.theme === "dark" ||
          (!root.dataset.theme &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        const render = () => {
          const icon = button.querySelector("span");
          if (icon) icon.textContent = isDark() ? "◑" : "◐";
          button.setAttribute(
            "aria-label",
            `Switch to ${isDark() ? "light" : "dark"} theme`,
          );
        };
        button.addEventListener("click", () => {
          const next = isDark() ? "light" : "dark";
          root.dataset.theme = next;
          try {
            localStorage.setItem("zerun-theme", next);
          } catch (e) {}
          render();
        });
        render();
      })();
    </script>
  </body>
</html>
