{
  "name": "zerun-niu-immersive-research-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build:site": "ASTRO_TELEMETRY_DISABLED=1 astro build && pagefind --site dist",
    "build": "pnpm run resumes && pnpm run build:site",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "resumes": "node scripts/export_resume_data.mjs && python3 scripts/generate_resumes.py",
    "resumes:verify": "python3 scripts/verify_pdfs.py",
    "links:verify": "node scripts/verify_links.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:test": "vitest run worker/test",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/react": "latest",
    "@astrojs/rss": "latest",
    "@astrojs/sitemap": "latest",
    "@elevenlabs/react": "latest",
    "@fontsource-variable/geist": "latest",
    "@fontsource-variable/geist-mono": "latest",
    "@react-three/drei": "latest",
    "@react-three/fiber": "latest",
    "astro": "latest",
    "lucide-react": "latest",
    "motion": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@cloudflare/workers-types": "latest",
    "@pagefind/default-ui": "latest",
    "@playwright/test": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "lighthouse": "^13.4.1",
    "pagefind": "latest",
    "prettier": "latest",
    "prettier-plugin-astro": "latest",
    "typescript": "^6.0.0",
    "vitest": "latest",
    "wrangler": "latest",
    "yaml": "latest"
  }
}
